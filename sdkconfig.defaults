# Native USB Serial/JTAG is reserved for ESCape32 Link traffic.
# Do not route stdio or ESP-IDF logs onto this interface.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# ESP32-C3 status LED baseline from upstream WiFi-Link: GPIO8, active low.
CONFIG_LED_PIN=8
CONFIG_LED_INV=y

# Original WiFi-Link Web UI services. They are linked into the image but
# initialized only when the persistent wifi_enabled setting is ON.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_MSL=3000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=1000
CONFIG_LWIP_IPV6=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y
